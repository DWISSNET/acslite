# Advanced ACS Server - Environment Configuration
# Copy ke .env untuk production use

# ============================================
# SERVER SETTINGS
# ============================================
PORT=7548
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb://localhost:27017/advanced_acs
REDIS_URI=redis://localhost:6379

# ============================================
# ACS TR-069 SETTINGS
# ============================================
CWMP_PORT=7547
ACS_URL=http://your-acs-server.com:7547
ACS_USERNAME=acsadmin
ACS_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# ============================================
# JWT / AUTHENTICATION
# ============================================
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
JWT_EXPIRES_IN=24h

# ============================================
# SMTP / EMAIL NOTIFICATIONS
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# FIRMWARE SERVER
# ============================================
FIRMWARE_BASE_URL=http://your-server.com/firmware/
FIRMWARE_STORAGE_PATH=/opt/acs/firmware/

# ============================================
# WEB DASHBOARD
# ============================================
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme123