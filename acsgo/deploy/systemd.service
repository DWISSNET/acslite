[Unit]
Description=ACSGO TR-069 ACS Server
Documentation=https://github.com/DWISSNET/acslite
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=acsgo
Group=acsgo
WorkingDirectory=/opt/acsgo
EnvironmentFile=/opt/acsgo/.env
ExecStart=/opt/acsgo/acsgo
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# Logging
StandardOutput=append:/var/log/acsgo/acsgo.log
StandardError=append:/var/log/acsgo/acsgo-error.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/acsgo/data /var/log/acsgo

# Resource limits
LimitNOFILE=1048576
LimitNPROC=65536

[Install]
WantedBy=multi-user.target
