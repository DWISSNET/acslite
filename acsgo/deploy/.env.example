# ACSGO Configuration Template
# Copy this file to .env and adjust values

# ============================================================
# Environment
# ============================================================
ENV=production

# ============================================================
# Server Ports
# ============================================================
# CWMP/TR-069 standard port (devices connect here)
CWMP_PORT=7547

# Web dashboard + REST API port
PORT=7548

# ============================================================
# Database
# ============================================================
# Use "sqlite" for embedded database (recommended for <500K devices)
# Use "postgres" for PostgreSQL (recommended for 500K+ devices)
DB_TYPE=sqlite

# SQLite: path to database file
DB_URL=./data/acsgo.db

# PostgreSQL DSN (uncomment to use PostgreSQL):
# DB_TYPE=postgres
# DB_URL=******localhost:5432/acsgo?sslmode=disable

# ============================================================
# Authentication
# ============================================================
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret-string-at-least-32-chars

# Admin credentials
ADMIN_EMAIL=admin@acsgo.local
ADMIN_PASSWORD=admin123
